# Credential-free production plan defaults. Keep recurring-cost services off
# until MANUAL-PREREQUISITES §2 is ready, then use production-shaped.tfvars.example.
aws_region                          = "ap-southeast-1"
environment                         = "production"
name                                = "production"
availability_zones                  = ["ap-southeast-1a", "ap-southeast-1b"]
enable_nat_gateway                  = false
enable_cloudfront                   = false
web_aliases                         = []
web_acm_certificate_arn             = ""
web_connect_src_origins             = []
enable_database                     = false
enable_ecs_services                 = false
backup_retention_period             = 7
deletion_protection                 = true
database_multi_az                   = true
redis_num_cache_clusters            = 2
redis_automatic_failover_enabled    = true
redis_multi_az_enabled              = true
api_desired_count                   = 2
worker_desired_count                = 2
worker_api_endpoint                 = ""
github_repository                   = ""
api_certificate_arn                 = ""
iam_email_from_address              = ""

# Keep OpenAI features disabled until the owner populates the dedicated
# databreeze/production/openai/api-key secret out of band.
openai_agent_enabled           = false
openai_receipt_enabled         = false
openai_dashboard_enabled       = false
openai_agent_model             = "gpt-4o-mini-2024-07-18"
openai_agent_timeout_ms        = 30000
openai_agent_max_output_tokens = 2048
openai_receipt_model           = "gpt-4o-mini-2024-07-18"
openai_dashboard_model         = "gpt-4o-mini-2024-07-18"
openai_image_detail            = "high"
openai_timeout_ms              = 30000
openai_max_output_tokens       = 2048
