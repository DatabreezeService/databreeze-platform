# Copy this file to infrastructure/local/.env for local development only.
# These values are intentionally local placeholders, not deployable secrets.

COMPOSE_PROJECT_NAME=databreeze-local
DATABREEZE_MIN_FREE_GIB=5

POSTGRES_IMAGE=docker.io/library/postgres:17.5-alpine
POSTGRES_DB=databreeze
POSTGRES_USER=databreeze
POSTGRES_PASSWORD=databreeze-local-change-me
POSTGRES_PORT=5432

REDIS_IMAGE=docker.io/library/redis:7.4.5-alpine
REDIS_PORT=6379

MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-06-13T11-33-47Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ROOT_USER=databreeze
MINIO_ROOT_PASSWORD=databreeze-local-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_ARTIFACTS=databreeze-artifacts
MINIO_BUCKET_RESULTS=databreeze-results

MAILPIT_IMAGE=axllent/mailpit:v1.21.8
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.128.0
HEALTHCHECK_IMAGE=curlimages/curl:8.14.1
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# The app profile is local-only and remains bound to loopback. Its fixed keys
# are synthetic development material, never production credentials.
WEB_HTTPS_PORT=8443
# Local development uses the running API/database by default. Set this to true
# only when you intentionally want the synthetic presentation dataset.
VITE_DATABREEZE_DEMO_MODE=false
# Presentation-only local hint: expose every registered product area in the
# navigation so the full local surface is easy to test. Server authorization
# still decides whether each request is allowed; this never grants access.
VITE_DATABREEZE_LOCAL_NAVIGATION_HINTS=true
# The local PayOS adapter is safe to exercise against the real local database
# in HMR too; production builds must leave this unset/false.
VITE_DATABREEZE_LOCAL_PAYMENT_MODE=mock
# Seed project used by project-scoped dashboard routes. Keep this aligned with
# services/api/scripts/seed-local.mjs so the real dashboard is discoverable
# immediately after `pnpm local:seed`. Leave it blank only when deliberately
# testing an empty workspace.
DATABREEZE_LOCAL_PROJECT_ID=00000000-0000-4000-8000-000000000003
# Stable synthetic-only password used by every account created by local:seed.
# Change it in your ignored .env if you share the machine.
DATABREEZE_LOCAL_SEED_PASSWORD=databreeze-local-change-me

# Local defaults to the deterministic mock adapter. Set PAYOS_PROVIDER=payos only
# when testing the signed provider integration with credentials in the ignored .env.
PAYOS_PROVIDER=mock
PAYOS_LOCAL_TEST_MODE=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
DATABREEZE_WEB_PUBLIC_URL=https://localhost:8443
DATABREEZE_PAYOS_SUCCESS_URL=https://localhost:8443/vi-VN/billing/success
DATABREEZE_PAYOS_FAILED_URL=https://localhost:8443/vi-VN/billing/failed

# Mailpit is the safe default. It captures OTP messages at http://localhost:8025.
DATABREEZE_LOCAL_EMAIL_PROVIDER=mailpit
DATABREEZE_IAM_SMTP_HOST=mailpit
DATABREEZE_IAM_SMTP_PORT=1025
# For real Gmail delivery, set the provider to gmail and fill these values in
# infrastructure/local/.env only. Use a Google App Password, never a normal
# Gmail password. Do not commit the local .env file.
# DATABREEZE_LOCAL_EMAIL_PROVIDER=gmail
# DATABREEZE_IAM_SMTP_HOST=smtp.gmail.com
# DATABREEZE_IAM_SMTP_PORT=465
# DATABREEZE_IAM_SMTP_USERNAME=your-account@gmail.com
# DATABREEZE_IAM_SMTP_APP_PASSWORD=abcdefghijklmnop
DATABREEZE_IAM_EMAIL_FROM_ADDRESS=verify@databreeze.local
DATABREEZE_IAM_EMAIL_VERIFICATION_DIGEST_KEY=ERERERERERERERERERERERERERERERERERERERERERE
DATABREEZE_IAM_EMAIL_VERIFICATION_ENVELOPE_KEY=EhISEhISEhISEhISEhISEhISEhISEhISEhISEhISEhI
DATABREEZE_IAM_INVITATION_DIGEST_KEY=GRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRk
DATABREEZE_IAM_REGISTRATION_ADMISSION_KEY=ExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExM
DATABREEZE_IAM_RECOVERY_DIGEST_KEY=FBUVFRUVFRUVFRUVFRUVFRUVFRUVFRUVFRUVFRUVFRU
DATABREEZE_SERVICE_ACCOUNT_SECRET_ENVELOPE_KEY=FBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQ
# Dedicated local-only HMAC key for worker capability signatures. Never reuse
# this value for service-account envelopes or any production environment.
DATABREEZE_IAE_WORKER_CAPABILITY_SIGNING_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc
# Bearer for the local seeded execution-worker service account. It is injected
# only into the worker container and hashed in PostgreSQL by `pnpm local:seed`.
DATABREEZE_LOCAL_WORKER_BEARER=databreeze-local-worker-bearer-change-me

# Optional provider gates. Keep them false until the corresponding local
# journey is intentionally being tested. Put the key only in the ignored
# infrastructure/local/.env file; never commit it or place it in the Web app.
DATABREEZE_OPENAI_AGENT_ENABLED=false
DATABREEZE_OPENAI_AGENT_MODEL=gpt-4o-mini-2024-07-18
DATABREEZE_OPENAI_AGENT_TIMEOUT_MS=30000
DATABREEZE_OPENAI_AGENT_MAX_OUTPUT_TOKENS=1200
DATABREEZE_OPENAI_RECEIPT_ENABLED=false
DATABREEZE_OPENAI_RECEIPT_MODEL=gpt-4o-mini-2024-07-18
DATABREEZE_OPENAI_DASHBOARD_ENABLED=false
DATABREEZE_OPENAI_DASHBOARD_MODEL=gpt-4o-mini-2024-07-18
DATABREEZE_OPENAI_ANALYSIS_ENABLED=false
DATABREEZE_OPENAI_ANALYSIS_MODEL=gpt-4o-mini-2024-07-18
DATABREEZE_OPENAI_NARRATIVE_ENABLED=false
DATABREEZE_OPENAI_NARRATIVE_MODEL=gpt-4o-mini-2024-07-18
DATABREEZE_OPENAI_MAPPING_ENABLED=false
DATABREEZE_OPENAI_MAPPING_MODEL=gpt-4o-mini-2024-07-18
# Set both this and the flag above to true only for an intentional local
# sample-egress test. The review UI still asks for per-import consent.
DATABREEZE_OPENAI_MAPPING_ALLOW_SAMPLES=false
# OPENAI_API_KEY=
