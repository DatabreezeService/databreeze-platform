COMPOSE_PROJECT_NAME=databreeze-pilot

# Owner configuration. Replace all values marked CHANGE_ME on the server only.
DATABREEZE_PILOT_DOMAIN=pilot.example.com
DATABREEZE_ACME_EMAIL=owner@example.com
DATABREEZE_IAM_EMAIL_FROM_ADDRESS=verify@databreeze.local
VITE_DATABREEZE_DEMO_MODE=true

POSTGRES_DB=databreeze
POSTGRES_USER=databreeze
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
MINIO_ROOT_USER=databreeze
MINIO_ROOT_PASSWORD=CHANGE_ME_RANDOM_MINIO_PASSWORD
MINIO_BUCKET_ARTIFACTS=databreeze-artifacts
MINIO_BUCKET_RESULTS=databreeze-results
MAILPIT_UI_PORT=8025

# Immutable OCI image references supplied by the protected deployment workflow.
API_IMAGE=ghcr.io/OWNER/databreeze-api:CHANGE_ME_COMMIT_SHA
API_MIGRATION_IMAGE=ghcr.io/OWNER/databreeze-api-migration:CHANGE_ME_COMMIT_SHA
WEB_IMAGE=ghcr.io/OWNER/databreeze-web:CHANGE_ME_COMMIT_SHA

# Generate each value as 32 random bytes encoded with base64url (43 characters).
DATABREEZE_IAM_EMAIL_VERIFICATION_DIGEST_KEY=CHANGE_ME_43_CHAR_BASE64URL_KEY
DATABREEZE_IAM_EMAIL_VERIFICATION_ENVELOPE_KEY=CHANGE_ME_43_CHAR_BASE64URL_KEY
DATABREEZE_IAM_REGISTRATION_ADMISSION_KEY=CHANGE_ME_43_CHAR_BASE64URL_KEY
DATABREEZE_SERVICE_ACCOUNT_SECRET_ENVELOPE_KEY=CHANGE_ME_43_CHAR_BASE64URL_KEY
