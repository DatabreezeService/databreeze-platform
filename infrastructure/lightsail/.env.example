COMPOSE_PROJECT_NAME=databreeze-pilot

# Owner configuration. Replace all values marked CHANGE_ME on the server only.
DATABREEZE_PILOT_DOMAIN=pilot.example.com
DATABREEZE_ACME_EMAIL=owner@example.com
# Mailpit is the default owner-test provider. Set these to Gmail SMTP values
# on the protected server only when real inbox delivery is required.
DATABREEZE_LOCAL_EMAIL_PROVIDER=mailpit
DATABREEZE_IAM_SMTP_HOST=mailpit
DATABREEZE_IAM_SMTP_PORT=1025
DATABREEZE_IAM_SMTP_USERNAME=
DATABREEZE_IAM_SMTP_APP_PASSWORD=
DATABREEZE_IAM_EMAIL_FROM_ADDRESS=verify@databreeze.local
VITE_DATABREEZE_DEMO_MODE=false

# The API receives OpenAI and PayOS credentials only from this protected host
# file. Keep the provider keys out of Git, images, browser variables, and logs.
# Required names: OPENAI_API_KEY, PAYOS_CLIENT_ID, PAYOS_API_KEY,
# PAYOS_CHECKSUM_KEY, DATABREEZE_PILOT_OPERATOR_PASSWORD.
DATABREEZE_OPENAI_AGENT_ENABLED=false
DATABREEZE_OPENAI_ANALYSIS_ENABLED=false
DATABREEZE_OPENAI_NARRATIVE_ENABLED=false
DATABREEZE_OPENAI_MAPPING_ENABLED=false
DATABREEZE_OPENAI_MAPPING_ALLOW_SAMPLES=false
DATABREEZE_OPENAI_RECEIPT_ENABLED=false
DATABREEZE_OPENAI_DASHBOARD_ENABLED=false
PAYOS_PROVIDER=payos
PAYOS_LOCAL_TEST_MODE=false
DATABREEZE_WEB_PUBLIC_URL=https://pilot.example.com
DATABREEZE_PAYOS_SUCCESS_URL=https://pilot.example.com/vi-VN/billing/success
DATABREEZE_PAYOS_FAILED_URL=https://pilot.example.com/vi-VN/billing/failed

# One-shot production-like fixture. Leave disabled except for an explicitly
# approved pilot activation. Email, display name, and password are server-only.
DATABREEZE_PILOT_SEED_ENABLED=false
DATABREEZE_PILOT_OPERATOR_EMAIL=
DATABREEZE_PILOT_OPERATOR_DISPLAY_NAME=

POSTGRES_DB=databreeze
POSTGRES_USER=databreeze
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
MINIO_ROOT_USER=databreeze
MINIO_ROOT_PASSWORD=CHANGE_ME_RANDOM_MINIO_PASSWORD
MINIO_BUCKET_ARTIFACTS=databreeze-artifacts
MINIO_BUCKET_RESULTS=databreeze-results
MAILPIT_UI_PORT=8025

# Immutable OCI image references supplied by the protected deployment workflow.
API_IMAGE=ghcr.io/OWNER/databreeze-api:CHANGE_ME_COMMIT_SHA
API_MIGRATION_IMAGE=ghcr.io/OWNER/databreeze-api-migration:CHANGE_ME_COMMIT_SHA
WEB_IMAGE=ghcr.io/OWNER/databreeze-web:CHANGE_ME_COMMIT_SHA

# Generate each value as 32 random bytes encoded with base64url (43 characters).
DATABREEZE_IAM_EMAIL_VERIFICATION_DIGEST_KEY=CHANGE_ME_43_CHAR_BASE64URL_KEY
DATABREEZE_IAM_EMAIL_VERIFICATION_ENVELOPE_KEY=CHANGE_ME_43_CHAR_BASE64URL_KEY
DATABREEZE_IAM_REGISTRATION_ADMISSION_KEY=CHANGE_ME_43_CHAR_BASE64URL_KEY
DATABREEZE_IAM_RECOVERY_DIGEST_KEY=CHANGE_ME_43_CHAR_BASE64URL_KEY
DATABREEZE_SERVICE_ACCOUNT_SECRET_ENVELOPE_KEY=CHANGE_ME_43_CHAR_BASE64URL_KEY
