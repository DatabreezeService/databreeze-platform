{
	admin off
	email {$DATABREEZE_ACME_EMAIL}
	storage file_system {
		root /data/caddy
	}
}

{$DATABREEZE_PILOT_DOMAIN} {
	encode zstd gzip

	@api path /v1/* /v3/* /health/*
	handle @api {
		reverse_proxy api:3000
	}

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
