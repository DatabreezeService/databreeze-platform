{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/telemetry/v1",
  "title": "DataBreeze content-safe telemetry record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "timestamp",
    "level",
    "event",
    "component",
    "correlationId",
    "attributes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "level": { "enum": ["debug", "info", "warn", "error"] },
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){0,7}$"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){0,5}$"
    },
    "correlationId": { "type": "string", "format": "uuid" },
    "traceId": { "type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$" },
    "spanId": { "type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$" },
    "traceFlags": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationId": { "type": "string", "maxLength": 128 },
        "workspaceId": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "principalId": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "jobId": { "type": "string", "maxLength": 128 },
        "attemptId": { "type": "string", "maxLength": 128 },
        "artifactId": { "type": "string", "maxLength": 128 },
        "artifactVersionId": { "type": "string", "maxLength": 128 },
        "datasetId": { "type": "string", "maxLength": 128 },
        "datasetVersionId": { "type": "string", "maxLength": 128 },
        "processorVersion": { "type": "string", "maxLength": 128 },
        "protocolVersion": { "type": "string", "maxLength": 128 },
        "route": { "type": "string", "maxLength": 256 },
        "operation": { "type": "string", "maxLength": 128 },
        "outcome": { "type": "string", "maxLength": 128 },
        "status": { "type": "number" },
        "reasonCode": { "type": "string", "maxLength": 128 },
        "errorCode": { "type": "string", "maxLength": 128 },
        "providerCode": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "maxLength": 128 },
        "dataClass": { "type": "string", "maxLength": 128 },
        "durationMs": { "type": "number" },
        "queueDelayMs": { "type": "number" },
        "retryCount": { "type": "number" },
        "itemCount": { "type": "number" },
        "byteCount": { "type": "number" },
        "redactedCount": { "type": "number" },
        "sampled": { "type": "boolean" }
      }
    }
  },
  "safeAttributeKeys": [
    "organizationId",
    "workspaceId",
    "projectId",
    "principalId",
    "deviceId",
    "jobId",
    "attemptId",
    "artifactId",
    "artifactVersionId",
    "datasetId",
    "datasetVersionId",
    "processorVersion",
    "protocolVersion",
    "route",
    "operation",
    "outcome",
    "status",
    "reasonCode",
    "errorCode",
    "providerCode",
    "mode",
    "dataClass",
    "durationMs",
    "queueDelayMs",
    "retryCount",
    "itemCount",
    "byteCount",
    "redactedCount",
    "sampled"
  ]
}
