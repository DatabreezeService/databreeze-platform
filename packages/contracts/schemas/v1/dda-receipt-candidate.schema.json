{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v1/dda-receipt-candidate",
  "$comment": "DDA-003, DDA-041: receipt candidate metadata without image bytes.",
  "title": "DDA Receipt Candidate",
  "description": "A receipt extraction candidate referencing opaque artifact and evidence IDs without embedding image bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "tenantScope",
    "artifactVersionId",
    "profileVersionId",
    "fieldCandidates",
    "adapterVersion",
    "evidenceReferenceId",
    "candidateHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "candidateId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "tenantScope": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/tenant-scope"
    },
    "artifactVersionId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "profileVersionId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "fieldCandidates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value",
          "confidence"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "evidenceReferenceId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "candidateHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
