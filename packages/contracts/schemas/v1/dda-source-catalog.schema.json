{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v1/dda-source-catalog",
  "$comment": "DDA-052: permission-filtered source catalog without Local paths.",
  "title": "DDA Source Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "tenantScope",
    "entries",
    "page",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "datasetId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "tenantScope": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/tenant-scope"
    },
    "entries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "safeDisplayLabel",
          "sourceType",
          "versionId",
          "status",
          "health"
        ],
        "properties": {
          "sourceId": {
            "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
          },
          "safeDisplayLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sourceType": {
            "type": "string",
            "pattern": "^(CSV|XLSX|IMAGE|PDF|RECEIPT|TABLE)$"
          },
          "versionId": {
            "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
          },
          "status": {
            "type": "string",
            "pattern": "^(ACTIVE|REVIEW|QUARANTINED|RETIRED)$"
          },
          "health": {
            "type": "string",
            "pattern": "^(HEALTHY|WARNING|BLOCKED|UNKNOWN)$"
          },
          "transformationCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "originalAction": {
            "type": "string",
            "pattern": "^(VIEW_SAFE|OPEN_ON_SOURCE_DEVICE|NONE)$"
          }
        }
      }
    },
    "page": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/cursor-page"
    },
    "generatedAt": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/utc-timestamp"
    }
  }
}
