{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v1/dda-materialization",
  "$comment": "DDA-003, DDA-029: complete materialization cache identity without result cells.",
  "title": "DDA Materialization",
  "description": "A materialization identity and result-manifest reference with a complete cache key and no raw result cells.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "materializationId",
    "tenantScope",
    "dashboardVersionId",
    "widgetId",
    "analysisPlanVersionId",
    "datasetVersionId",
    "semanticVersionId",
    "metricVersionId",
    "permissionProjectionVersionId",
    "parameterHash",
    "locale",
    "timezone",
    "engineVersion",
    "adapterVersion",
    "effectivePolicyVersionId",
    "resultManifestId",
    "cacheIdentityHash",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "materializationId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "tenantScope": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/tenant-scope"
    },
    "dashboardVersionId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "widgetId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "analysisPlanVersionId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "datasetVersionId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "semanticVersionId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "metricVersionId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "permissionProjectionVersionId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "parameterHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "effectivePolicyVersionId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "resultManifestId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "cacheIdentityHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "createdAt": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/utc-timestamp"
    }
  }
}
