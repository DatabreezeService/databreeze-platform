{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v4/crf-report-detail-accepted",
  "title": "CRF Report Detail Accepted",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "accepted", "report"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "accepted": { "const": true },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "reportId", "name", "clientId", "period", "datasetId", "datasetVersionId", "status", "reportVersion", "updatedAt", "templateId", "templateVersion", "supportedFormats", "blockCount"],
      "properties": {
        "schemaVersion": { "const": 4 },
        "reportId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "clientId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "period": { "type": "string", "minLength": 1, "maxLength": 64 },
        "datasetId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "datasetVersionId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "status": { "enum": ["DRAFT", "RUNNING", "REVIEW", "RELEASED", "WITHDRAWN", "BLOCKED"] },
        "reportVersion": { "type": "integer", "minimum": 1 },
        "updatedAt": { "$ref": "https://schemas.databreeze.dev/contracts/v1/utc-timestamp" },
        "latestRunStatus": { "enum": ["QUEUED", "RUNNING", "BLOCKED", "REVIEW", "RELEASED", "FAILED"] },
        "templateId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "templateVersion": { "type": "integer", "minimum": 1 },
        "supportedFormats": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["DOCX", "PPTX", "XLSX", "PDF", "WEB"] } },
        "blockCount": { "type": "integer", "minimum": 0, "maximum": 200 },
        "latestRun": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId", "reportVersion", "status", "createdAt"],
          "properties": {
            "runId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
            "reportVersion": { "type": "integer", "minimum": 1 },
            "status": { "enum": ["QUEUED", "RUNNING", "BLOCKED", "REVIEW", "RELEASED", "FAILED"] },
            "createdAt": { "$ref": "https://schemas.databreeze.dev/contracts/v1/utc-timestamp" },
            "finishedAt": { "$ref": "https://schemas.databreeze.dev/contracts/v1/utc-timestamp" }
          }
        }
      }
    }
  }
}
