{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v4/platform-admin-feedbacks",
  "$comment": "IAM-026, WEB-027: bounded content-minimized landing feedback review read. Exposes only visitor-submitted fields; never network identifiers or admission digests.",
  "title": "Platform Admin Feedbacks",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "total", "feedbacks"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "generatedAt": { "$ref": "https://schemas.databreeze.dev/contracts/v1/utc-timestamp" },
    "total": { "$ref": "#/$defs/feedbackCount" },
    "feedbacks": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/feedback" }
    }
  },
  "$defs": {
    "feedbackCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "feedbackRole": {
      "enum": ["owner", "analyst", "accounting", "operations", "technology", "other"]
    },
    "feedbackExperience": { "enum": ["exploring", "trial", "active"] },
    "feedbackCategory": {
      "enum": ["product", "feature", "data-trust", "design", "performance", "other"]
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt",
        "email",
        "role",
        "experience",
        "category",
        "rating",
        "message",
        "contactPermission"
      ],
      "properties": {
        "id": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "createdAt": { "$ref": "https://schemas.databreeze.dev/contracts/v1/utc-timestamp" },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "organization": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "$ref": "#/$defs/feedbackRole" },
        "experience": { "$ref": "#/$defs/feedbackExperience" },
        "category": { "$ref": "#/$defs/feedbackCategory" },
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "message": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "contactPermission": { "type": "boolean" }
      }
    }
  }
}
