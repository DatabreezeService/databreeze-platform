{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v4/iam-password-sign-in-command",
  "$comment": "IAM-005/IAM-023: bounded email/password sign-in command without client-selected tenant authority.",
  "title": "IAM Password Sign In Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "email", "password", "clientPlatform"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "email": { "type": "string", "minLength": 3, "maxLength": 254, "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
    "password": { "type": "string", "minLength": 12, "maxLength": 128, "pattern": "^[^\\u0000\\r\\n]+$" },
    "clientPlatform": { "type": "string", "enum": ["android", "desktop", "web"] }
  }
}
