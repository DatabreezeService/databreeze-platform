{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v4/dda-conversation-summary",
  "$comment": "DDA-055/DDA-056: content-safe authorized conversation metadata for history and load responses.",
  "title": "DDA Conversation Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "conversationId",
    "title",
    "datasets",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "conversationId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/datasetBinding" }
    },
    "dashboardId": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
    },
    "filterContext": {
      "type": "string",
      "maxLength": 4000
    },
    "createdAt": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/utc-timestamp"
    },
    "updatedAt": {
      "$ref": "https://schemas.databreeze.dev/contracts/v1/utc-timestamp"
    }
  },
  "$defs": {
    "datasetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "datasetVersionId"],
      "properties": {
        "datasetId": {
          "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
        },
        "datasetVersionId": {
          "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
        }
      }
    }
  }
}
