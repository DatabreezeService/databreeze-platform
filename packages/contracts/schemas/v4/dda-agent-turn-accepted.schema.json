{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v4/dda-agent-turn-accepted",
  "$comment": "DDA-015 through DDA-019 and DDA-060: bounded accepted turn with closed typed tool-result envelopes.",
  "title": "DDA Agent Turn Accepted",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "accepted", "narrative", "toolResults"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "accepted": { "const": true },
    "narrative": {
      "type": "string",
      "maxLength": 8000
    },
    "toolResults": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/toolResult" }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind"],
      "properties": {
        "evidenceId": {
          "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
        },
        "kind": {
          "type": "string",
          "enum": ["RESULT_CELL", "SOURCE", "EXTRACTION"]
        }
      }
    },
    "toolCallId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "toolResult": {
      "oneOf": [
        { "$ref": "#/$defs/datasetDescribeResult" },
        { "$ref": "#/$defs/datasetSampleResult" },
        { "$ref": "#/$defs/analysisPlanResult" },
        { "$ref": "#/$defs/analysisExecuteResult" },
        { "$ref": "#/$defs/dashboardProposeResult" },
        { "$ref": "#/$defs/dashboardApplyConfirmedResult" },
        { "$ref": "#/$defs/dashboardExplainValueResult" },
        { "$ref": "#/$defs/evidenceResolveResult" },
        { "$ref": "#/$defs/sourceOpenResult" },
        { "$ref": "#/$defs/etlProposeCorrectionResult" }
      ]
    },
    "datasetDescribeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "name", "result"],
      "properties": {
        "toolCallId": { "$ref": "#/$defs/toolCallId" },
        "name": { "const": "dataset.describe" },
        "result": { "$ref": "#/$defs/datasetDescribeValue" }
      }
    },
    "datasetDescribeValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "schema", "evidenceRefs"],
      "properties": {
        "datasetId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "schema": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/schemaField" }
        },
        "evidenceRefs": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "schemaField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "type"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "datasetSampleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "name", "result"],
      "properties": {
        "toolCallId": { "$ref": "#/$defs/toolCallId" },
        "name": { "const": "dataset.sample" },
        "result": { "$ref": "#/$defs/datasetSampleValue" }
      }
    },
    "datasetSampleValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "sampleId", "columns", "evidenceRefs"],
      "properties": {
        "datasetId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "sampleId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "columns": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "evidenceRefs": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "analysisPlanResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "name", "result"],
      "properties": {
        "toolCallId": { "$ref": "#/$defs/toolCallId" },
        "name": { "const": "analysis.plan" },
        "result": { "$ref": "#/$defs/analysisPlanValue" }
      }
    },
    "analysisPlanValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "planVersionId",
        "datasetId",
        "datasetVersionId",
        "preview",
        "evidenceRefs"
      ],
      "properties": {
        "planId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "planVersionId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "datasetId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "datasetVersionId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "preview": { "$ref": "#/$defs/availablePreview" },
        "evidenceRefs": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "availablePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": { "available": { "const": true } }
    },
    "analysisExecuteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "name", "result"],
      "properties": {
        "toolCallId": { "$ref": "#/$defs/toolCallId" },
        "name": { "const": "analysis.execute" },
        "result": { "$ref": "#/$defs/analysisExecuteValue" }
      }
    },
    "analysisExecuteValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultId", "evidenceRefs", "provenance"],
      "properties": {
        "resultId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "evidenceRefs": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/evidenceRef" } },
        "provenance": { "$ref": "#/$defs/resultProvenance" }
      }
    },
    "resultProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planVersionId", "datasetVersionId", "engineVersion"],
      "properties": {
        "planVersionId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "datasetVersionId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "engineVersion": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "dashboardProposeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "name", "result"],
      "properties": {
        "toolCallId": { "$ref": "#/$defs/toolCallId" },
        "name": { "const": "dashboard.propose" },
        "result": { "$ref": "#/$defs/dashboardProposeValue" }
      }
    },
    "dashboardProposeValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "options", "evidenceRefs"],
      "properties": {
        "proposalId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "options": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/dashboardOption" }
        },
        "evidenceRefs": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "dashboardOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId"],
      "properties": {
        "optionId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "dashboardApplyConfirmedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "name", "result"],
      "properties": {
        "toolCallId": { "$ref": "#/$defs/toolCallId" },
        "name": { "const": "dashboard.applyConfirmed" },
        "result": { "$ref": "#/$defs/dashboardApplyConfirmedValue" }
      }
    },
    "dashboardApplyConfirmedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "revision", "evidenceRefs"],
      "properties": {
        "commandId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "revision": { "$ref": "https://schemas.databreeze.dev/contracts/v1/revision" },
        "evidenceRefs": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "dashboardExplainValueResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "name", "result"],
      "properties": {
        "toolCallId": { "$ref": "#/$defs/toolCallId" },
        "name": { "const": "dashboard.explainValue" },
        "result": { "$ref": "#/$defs/dashboardExplainValue" }
      }
    },
    "dashboardExplainValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explanation", "evidenceRefs"],
      "properties": {
        "explanation": { "type": "string", "maxLength": 4000 },
        "evidenceRefs": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "evidenceResolveResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "name", "result"],
      "properties": {
        "toolCallId": { "$ref": "#/$defs/toolCallId" },
        "name": { "const": "evidence.resolve" },
        "result": { "$ref": "#/$defs/evidenceResolveValue" }
      }
    },
    "evidenceResolveValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "reference"],
      "properties": {
        "evidenceId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "reference": { "$ref": "#/$defs/evidenceReference" }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "resultId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "sourceId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "extractionId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "artifactId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "datasetId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "datasetVersionId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "contentReferenceId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" }
      }
    },
    "sourceOpenResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "name", "result"],
      "properties": {
        "toolCallId": { "$ref": "#/$defs/toolCallId" },
        "name": { "const": "source.open" },
        "result": { "$ref": "#/$defs/sourceOpenValue" }
      }
    },
    "sourceOpenValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "kind", "evidenceRefs"],
      "properties": {
        "sourceId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "iaeContentReferenceId": {
          "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier"
        },
        "evidenceRefs": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "etlProposeCorrectionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallId", "name", "result"],
      "properties": {
        "toolCallId": { "$ref": "#/$defs/toolCallId" },
        "name": { "const": "etl.proposeCorrection" },
        "result": { "$ref": "#/$defs/etlProposeCorrectionValue" }
      }
    },
    "etlProposeCorrectionValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "state", "evidenceRefs"],
      "properties": {
        "proposalId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "state": { "type": "string", "minLength": 1, "maxLength": 64 },
        "evidenceRefs": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    }
  }
}
