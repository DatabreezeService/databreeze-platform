{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v4/dda-data-import-dashboard-preview",
  "$comment": "Plan 413 / DDA-053: bounded, server-owned preview derived from one exact approved import. This is not a certified snapshot or publication.",
  "title": "DDA Data Import Dashboard Preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "accepted", "value"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "accepted": { "const": true },
    "value": { "$ref": "#/$defs/value" }
  },
  "$defs": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importId",
        "datasetId",
        "datasetVersionId",
        "datasetName",
        "sourceCount",
        "rowCount",
        "truncated",
        "sourceHashes",
        "columns",
        "sampleRows",
        "generatedAt"
      ],
      "properties": {
        "importId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "datasetId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "datasetVersionId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "datasetName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceCount": { "type": "integer", "minimum": 1, "maximum": 8 },
        "rowCount": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "truncated": { "type": "boolean" },
        "sourceHashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/column" }
        },
        "measure": { "$ref": "#/$defs/measure" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "sampleRows": {
          "type": "array",
          "maxItems": 25,
          "items": { "$ref": "#/$defs/sampleRow" }
        },
        "generatedAt": { "$ref": "https://schemas.databreeze.dev/contracts/v1/utc-timestamp" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "nullable"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "enum": ["TEXT", "INTEGER", "DECIMAL", "BOOLEAN", "DATE"] },
        "nullable": { "type": "boolean" }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "sum", "average", "minimum", "maximum"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sum": { "type": "number" },
        "average": { "type": "number" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "groups"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 128 },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/group" }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "count"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "count": { "type": "integer", "minimum": 1 },
        "total": { "type": "number" }
      }
    },
    "sampleRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cells"],
      "properties": {
        "cells": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/sampleCell" }
        }
      }
    },
    "sampleCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "kind"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": "string", "maxLength": 8192 },
        "kind": { "enum": ["TEXT", "NUMBER", "BOOLEAN", "EMPTY"] }
      }
    }
  }
}
