{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v4/jra-worker-result-prepare-accepted",
  "$comment": "JRA-023/JRA-031/IAE-024: stable attempt-bound result submission and opaque IAE write capabilities, without provider URLs, paths, or credentials.",
  "title": "JRA Worker Result Prepare Accepted",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "accepted", "submissionId", "attemptId", "descriptorBindingHash", "expiresAt", "outputs"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "accepted": { "const": true },
    "submissionId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
    "attemptId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
    "descriptorBindingHash": { "$ref": "#/$defs/preparedSha256" },
    "expiresAt": { "$ref": "https://schemas.databreeze.dev/contracts/v1/utc-timestamp" },
    "outputs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/preparedOutput" } }
  },
  "$defs": {
    "preparedSafeName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "preparedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "preparedMediaType": { "type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$" },
    "preparedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputName", "capabilityId", "objectId", "maxBytes", "allowedMediaTypes", "writeCapability"],
      "properties": {
        "outputName": { "$ref": "#/$defs/preparedSafeName" },
        "capabilityId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "objectId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "allowedMediaTypes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/preparedMediaType" } },
        "writeCapability": { "type": "string", "minLength": 16, "maxLength": 4096, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{15,4095}$" }
      }
    }
  }
}
