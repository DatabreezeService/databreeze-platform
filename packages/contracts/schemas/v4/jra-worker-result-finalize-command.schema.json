{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v4/jra-worker-result-finalize-command",
  "$comment": "JRA-012/JRA-031/IAE-024: finalize one prepared result using content-free IAE attestation references and a typed binding echo only.",
  "title": "JRA Worker Result Finalize Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "submissionId", "attemptId", "leaseToken", "expectedRevision", "descriptorBindingHash", "idempotencyKey", "attestations", "resultBinding"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "submissionId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
    "attemptId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
    "leaseToken": { "$ref": "#/$defs/finalizeOpaqueToken" },
    "expectedRevision": { "$ref": "https://schemas.databreeze.dev/contracts/v1/revision" },
    "descriptorBindingHash": { "$ref": "#/$defs/finalizeSha256" },
    "idempotencyKey": { "$ref": "#/$defs/finalizeIdempotencyKey" },
    "attestations": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/resultAttestation" } },
    "resultBinding": { "$ref": "#/$defs/workerResultBinding" }
  },
  "$defs": {
    "finalizeOpaqueToken": { "type": "string", "minLength": 16, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{15,511}$" },
    "finalizeIdempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "finalizeSafeName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "finalizeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resultAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputName", "attestationId"],
      "properties": {
        "outputName": { "$ref": "#/$defs/finalizeSafeName" },
        "attestationId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" }
      }
    },
    "workerResultBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "outputSchemaId", "outputNames"],
      "properties": {
        "kind": { "const": "OUTPUT_SET" },
        "outputSchemaId": { "$ref": "#/$defs/finalizeSafeName" },
        "outputNames": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/finalizeSafeName" } }
      }
    }
  }
}
