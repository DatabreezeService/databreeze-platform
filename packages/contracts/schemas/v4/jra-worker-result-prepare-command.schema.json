{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.databreeze.dev/contracts/v4/jra-worker-result-prepare-command",
  "$comment": "JRA-023/JRA-031/IAE-024: worker declaration for server-authorized result preparation; no tenant, storage, or object authority is caller supplied.",
  "title": "JRA Worker Result Prepare Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "attemptId", "leaseToken", "expectedRevision", "idempotencyKey", "outputs"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "attemptId": { "$ref": "https://schemas.databreeze.dev/contracts/v1/identifier" },
    "leaseToken": { "$ref": "#/$defs/prepareOpaqueToken" },
    "expectedRevision": { "$ref": "https://schemas.databreeze.dev/contracts/v1/revision" },
    "idempotencyKey": { "$ref": "#/$defs/prepareIdempotencyKey" },
    "outputs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/workerOutputDeclaration" } }
  },
  "$defs": {
    "prepareOpaqueToken": { "type": "string", "minLength": 16, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{15,511}$" },
    "prepareIdempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "prepareSafeName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "prepareSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workerOutputDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "outputName", "schemaId", "mediaType", "contentSha256", "byteLength", "sourceLineageHash"],
      "properties": {
        "kind": { "enum": ["JSON_RESULT", "BINARY_RESULT"] },
        "outputName": { "$ref": "#/$defs/prepareSafeName" },
        "schemaId": { "$ref": "#/$defs/prepareSafeName" },
        "mediaType": { "type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$" },
        "contentSha256": { "$ref": "#/$defs/prepareSha256" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sourceLineageHash": { "$ref": "#/$defs/prepareSha256" }
      }
    }
  }
}
