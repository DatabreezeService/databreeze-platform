{
  "name": "@databreeze/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "openapi:check": "tsc --project tsconfig.build.json && node scripts/generate-openapi.mjs --check && pnpm openapi:validate",
    "openapi:generate": "tsc --project tsconfig.build.json && node scripts/generate-openapi.mjs",
    "openapi:validate": "redocly lint openapi/v1.json --extends spec",
    "pretest": "corepack pnpm --filter @databreeze/domain build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "test": "node --test test/**/*.test.mjs && tsc --project tsconfig.test.json && node --test build/test/test/**/*.test.js",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "@aws-sdk/client-sesv2": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "3.1108.0",
    "@databreeze/contracts": "workspace:*",
    "@databreeze/domain": "workspace:*",
    "@databreeze/telemetry": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.10.0",
    "openai": "4.104.0",
    "redis": "^6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@redocly/cli": "2.43.2",
    "@types/node": "24.13.3",
    "prettier": "3.6.2",
    "prisma": "7.9.1",
    "typescript": "5.9.2"
  }
}
