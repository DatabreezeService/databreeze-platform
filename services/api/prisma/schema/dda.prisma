/// Durable open/historical refresh executions (metadata only — no result rows).
model DashboardRefreshExecutionRecord {
  id                              String   @id @db.Uuid
  scopeType                       String   @map("scope_type") @db.VarChar(24)
  organizationId                  String   @map("organization_id") @db.Uuid
  workspaceId                     String   @map("workspace_id") @db.Uuid
  projectId                       String   @map("project_id") @db.Uuid
  dashboardId                     String   @map("dashboard_id") @db.Uuid
  dashboardVersionId              String   @map("dashboard_version_id") @db.Uuid
  permissionProjectionVersionId   String   @map("permission_projection_version_id") @db.Uuid
  datasetVersionId                String   @map("dataset_version_id") @db.Uuid
  definitionIds                   Json     @map("definition_ids")
  inputSelectorHash               String   @map("input_selector_hash") @db.Char(64)
  sourceEventIds                  Json     @map("source_event_ids")
  clientRequestIds                Json     @map("client_request_ids")
  folderReplayKeys                Json     @map("folder_replay_keys")
  state                           String   @db.VarChar(32)
  leaseId                         String?  @map("lease_id") @db.VarChar(128)
  debounceWindowMs                Int      @map("debounce_window_ms")
  openedAtMs                      BigInt   @map("opened_at_ms")
  updatedAtMs                     BigInt   @map("updated_at_ms")
  updatedAt                       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, workspaceId, projectId, dashboardId, state], map: "dashboard_refresh_executions_open_idx")
  @@map("dashboard_refresh_executions")
  @@schema("dda")
}

