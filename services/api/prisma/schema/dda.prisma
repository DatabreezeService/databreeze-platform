/// DDA-025/AUD-003: durable transactional command for invalidating approvals
/// of the prior published dashboard-version subject. A dispatcher owned by
/// the root composition consumes PENDING rows after this publication commit.
model DashboardPublicationApprovalInvalidationOutboxRecord {
  id                      String    @id @db.Uuid
  keyValue                String    @map("key_value") @db.VarChar(200)
  snapshotId              String    @map("snapshot_id") @db.Uuid
  dashboardId             String    @map("dashboard_id") @db.Uuid
  priorPublishedVersionId String    @map("prior_published_version_id") @db.Uuid
  scopeType               String    @map("scope_type") @db.VarChar(24)
  organizationId          String    @map("organization_id") @db.Uuid
  workspaceId             String    @map("workspace_id") @db.Uuid
  projectId               String    @map("project_id") @db.Uuid
  action                  String    @db.VarChar(96)
  state                   String    @db.VarChar(16)
  attempts                Int       @default(0)
  leaseOwner              String?   @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt          DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  nextAttemptAt           DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  lastError               String?   @map("last_error") @db.VarChar(512)
