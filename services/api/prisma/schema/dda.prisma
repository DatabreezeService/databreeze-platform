/// NCO-001/NCO-002/NCO-003/NCO-012: recipient-scoped, content-safe notification intent.
/// This row stores labels and opaque identifiers only. Source content, OCR values,
/// evidence, credentials, and paths are intentionally not represented.
model DdaNotificationIntent {
  id                String    @id @db.Uuid
  eventId           String    @map("event_id") @db.Uuid
  eventHash         String    @map("event_hash") @db.Char(64)
  organizationId    String    @map("organization_id") @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  recipientId       String    @map("recipient_id") @db.Uuid
  subjectId         String    @map("subject_id") @db.Uuid
  kind              String    @db.VarChar(64)
  action            String    @db.VarChar(32)
  labelVi           String    @map("label_vi") @db.VarChar(160)
  labelEn           String    @map("label_en") @db.VarChar(160)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  correlationId     String    @map("correlation_id") @db.Uuid
  occurrenceCount   Int       @default(1) @map("occurrence_count")
  firstOccurredAt   DateTime  @map("first_occurred_at") @db.Timestamptz(6)
  lastOccurredAt    DateTime  @map("last_occurred_at") @db.Timestamptz(6)
  bundleKey         String    @map("bundle_key") @db.Char(64)
  bundleWindowStart DateTime  @map("bundle_window_start") @db.Timestamptz(6)
  state             String    @default("UNREAD") @db.VarChar(16)
  revision          Int       @default(1)
  dismissedAt       DateTime? @map("dismissed_at") @db.Timestamptz(6)

  @@unique([organizationId, workspaceId, recipientId, id], map: "notification_intents_recipient_id_key")
  @@unique([organizationId, workspaceId, recipientId, bundleKey], map: "notification_intents_recipient_bundle_key")
  @@index([organizationId, workspaceId, recipientId, createdAt, id], map: "notification_intents_recipient_cursor_idx")
  @@index([organizationId, workspaceId, recipientId, state], map: "notification_intents_recipient_state_idx")
  @@map("notification_intents")
  @@schema("dda")
}

/// NCO-001/NCO-002: durable per-recipient committed-event delivery receipt.
