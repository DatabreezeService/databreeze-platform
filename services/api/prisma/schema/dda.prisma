/// DDA-001, DDA-003: dashboard-agent metadata only. Original payloads, datasets, jobs,
/// devices, usage, and audit remain with IAE/DSM/JRA/DSO/BUA/AUD and are referenced by ID.
model DashboardRecord {
  id                 String   @id @db.Uuid
  scopeType          String   @map("scope_type") @db.VarChar(24)
  organizationId     String   @map("organization_id") @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  projectId          String   @map("project_id") @db.Uuid
  titleVi            String   @map("title_vi") @db.VarChar(200)
  titleEn            String   @map("title_en") @db.VarChar(200)
  status             String   @db.VarChar(24)
  draftVersionId     String?  @map("draft_version_id") @db.Uuid
  publishedVersionId String?  @map("published_version_id") @db.Uuid
  revision           Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, workspaceId, projectId, id], map: "dashboards_scope_id_key")
  @@index([organizationId, workspaceId, projectId], map: "dashboards_scope_idx")
  @@map("dashboards")
  @@schema("dda")
}

