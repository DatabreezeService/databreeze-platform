/// DDA-060: durable, tenant/actor/tool/idempotency-owned mutation reservation and replay.
/// Only bounded content-safe tool results and opaque result references are stored; raw rows,
/// cells, source content, paths, queries, credentials, and provider payloads are not represented.
model AgentConsequentialCommandRecord {
  id                       String    @id @db.Uuid
  tenantScopeKey           String    @map("tenant_scope_key") @db.VarChar(180)
  scopeType                String    @map("scope_type") @db.VarChar(24)
  organizationId           String    @map("organization_id") @db.Uuid
  workspaceId              String?   @map("workspace_id") @db.Uuid
  projectId                String?   @map("project_id") @db.Uuid
  actorId                  String    @map("actor_id") @db.Uuid
  toolName                 String    @map("tool_name") @db.VarChar(64)
  idempotencyKey           String    @map("idempotency_key") @db.VarChar(200)
  inputFingerprint         String    @map("input_fingerprint") @db.Char(64)
  correlationId            String    @map("correlation_id") @db.Uuid
  state                    String    @db.VarChar(32)
  ownerToken               String    @map("owner_token") @db.VarChar(128)
  leaseExpiresAt           DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  auditIntentAt            DateTime  @map("audit_intent_at") @db.Timestamptz(6)
  auditAttemptedAt         DateTime? @map("audit_attempted_at") @db.Timestamptz(6)
  auditSucceededAt         DateTime? @map("audit_succeeded_at") @db.Timestamptz(6)
  auditFailureCode         String?   @map("audit_failure_code") @db.VarChar(96)
  resultReferenceId        String?   @map("result_reference_id") @db.Uuid
  resultDocument           Json?     @map("result_document")
  failureCode              String?   @map("failure_code") @db.VarChar(96)
  reconciliationRequiredAt DateTime? @map("reconciliation_required_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt              DateTime? @map("completed_at") @db.Timestamptz(6)

  @@unique([tenantScopeKey, actorId, toolName, idempotencyKey], map: "agent_commands_tenant_actor_tool_key")
  @@index([organizationId, workspaceId, projectId, state, updatedAt], map: "agent_commands_scope_state_idx")
  @@index([tenantScopeKey, state, leaseExpiresAt], map: "agent_commands_lease_idx")
  @@map("agent_consequential_commands")
  @@schema("dda")
}
