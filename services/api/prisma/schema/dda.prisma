  @@unique([organizationId, workspaceId, recipientId, eventId], map: "notification_projection_receipts_event_key")
  @@index([organizationId, workspaceId, recipientId, notificationId], map: "notification_projection_receipts_notification_idx")
  @@map("notification_projection_receipts")
  @@schema("dda")
}

