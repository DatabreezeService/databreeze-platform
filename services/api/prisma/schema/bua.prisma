/// BUA-owned provider-independent entitlements and append-only usage ledger.
/// Scope ancestry is materialized for indexed authorization checks; cross-module
/// identities remain opaque UUIDs and plan/snapshot payloads are immutable JSON.
model EntitlementPlanRecord {
  planCode            String   @id @map("plan_code") @db.VarChar(40)
  schemaVersion       Int      @map("schema_version")
  displayNameKey      String   @map("display_name_key") @db.VarChar(120)
  features            Json
  quotas              Json
  providerIndependent Boolean  @default(true) @map("provider_independent")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("entitlement_plans")
  @@schema("bua")
}

model EntitlementSnapshotRecord {
  id             String    @id @db.Uuid
  schemaVersion  Int       @map("schema_version")
  scopeKey       String    @map("scope_key") @db.VarChar(200)
  scopeType      String    @map("scope_type") @db.VarChar(24)
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  planCode       String    @map("plan_code") @db.VarChar(40)
  status         String    @db.VarChar(24)
  revision       Int
  securityEpoch  Int       @map("security_epoch")
  effectiveAt    DateTime  @map("effective_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  features       Json
  quotas         Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scopeKey, revision], map: "entitlement_snapshots_scope_revision_key")
  @@index([organizationId, workspaceId, revision], map: "entitlement_snapshots_scope_idx")
  @@index([planCode], map: "entitlement_snapshots_plan_idx")
  @@map("entitlement_snapshots")
  @@schema("bua")
}

/// BUA-017/018: signed offline leases are immutable and bound to a snapshot revision/epoch.
model EntitlementLeaseRecord {
  id               String   @id @db.Uuid
  schemaVersion    Int      @map("schema_version")
  scopeKey         String   @map("scope_key") @db.VarChar(200)
  scopeType        String   @map("scope_type") @db.VarChar(24)
  organizationId   String   @map("organization_id") @db.Uuid
  workspaceId      String?  @map("workspace_id") @db.Uuid
  snapshotRevision Int      @map("snapshot_revision")
  securityEpoch    Int      @map("security_epoch")
  issuedAt         DateTime @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  payload          String   @db.Text
  signature        String   @db.VarChar(2048)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, workspaceId, expiresAt], map: "entitlement_leases_scope_expiry_idx")
  @@map("entitlement_leases")
  @@schema("bua")
}

model UsageLedgerEntryRecord {
  id             String   @id @db.Uuid
  schemaVersion  Int      @map("schema_version")
  scopeKey       String   @map("scope_key") @db.VarChar(200)
  scopeType      String   @map("scope_type") @db.VarChar(24)
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String?  @map("workspace_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  metric         String   @db.VarChar(40)
  bucket         String   @db.VarChar(16)
  deltaUnits     BigInt   @map("delta_units")
  sequence       Int
  reservationId  String?  @map("reservation_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(200)
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scopeKey, metric, sequence], map: "usage_ledger_scope_metric_sequence_key")
  @@unique([scopeKey, idempotencyKey], map: "usage_ledger_scope_idempotency_key")
  @@index([organizationId, workspaceId, projectId, metric, sequence], map: "usage_ledger_scope_idx")
  @@index([reservationId], map: "usage_ledger_reservation_idx")
  @@map("usage_ledger_entries")
  @@schema("bua")
}

model UsageReservationRecord {
  id                String                              @id @db.Uuid
  scopeKey          String                              @map("scope_key") @db.VarChar(200)
  scopeType         String                              @map("scope_type") @db.VarChar(24)
  organizationId    String                              @map("organization_id") @db.Uuid
  workspaceId       String?                             @map("workspace_id") @db.Uuid
  projectId         String?                             @map("project_id") @db.Uuid
  metric            String                              @db.VarChar(40)
  reservedUnits     BigInt                              @map("reserved_units")
  status            String                              @db.VarChar(16)
  createdAt         DateTime                            @map("created_at") @db.Timestamptz(6)
  revision          Int
  updatedAt         DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(6)
  settlementBinding ResultUsageSettlementBindingRecord?

  @@index([organizationId, workspaceId, projectId, status], map: "usage_reservations_scope_idx")
  @@index([scopeKey, metric], map: "usage_reservations_metric_idx")
  @@map("usage_reservations")
  @@schema("bua")
}

/// BUA-023: immutable server-admission authority for result usage settlement.
model ResultUsageSettlementBindingRecord {
  id                             String                 @id @db.Uuid
  schemaVersion                  Int                    @map("schema_version")
  scopeKey                       String                 @map("scope_key") @db.VarChar(200)
  scopeType                      String                 @map("scope_type") @db.VarChar(24)
  organizationId                 String                 @map("organization_id") @db.Uuid
  workspaceId                    String?                @map("workspace_id") @db.Uuid
  projectId                      String?                @map("project_id") @db.Uuid
  jobId                          String                 @map("job_id") @db.Uuid
  reservationId                  String                 @unique(map: "result_usage_settlement_bindings_reservation_key") @map("reservation_id") @db.Uuid
  meter                          String                 @db.VarChar(40)
  settlementFormula              String                 @map("settlement_formula") @db.VarChar(40)
  maximumAdmittedUnits           BigInt                 @map("maximum_admitted_units")
  entitlementDecisionSubjectHash String                 @map("entitlement_decision_subject_hash") @db.Char(64)
  admissionIdempotencyKey        String                 @map("admission_idempotency_key") @db.VarChar(200)
  state                          String                 @db.VarChar(16)
  createdAt                      DateTime               @map("created_at") @db.Timestamptz(6)
  expiresAt                      DateTime               @map("expires_at") @db.Timestamptz(6)
  revision                       Int
  reservation                    UsageReservationRecord @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([scopeKey, jobId], map: "result_usage_settlement_bindings_scope_job_key")
  @@unique([scopeKey, admissionIdempotencyKey], map: "result_usage_settlement_bindings_scope_idempotency_key")
  @@index([organizationId, workspaceId, projectId, state, expiresAt], map: "result_usage_settlement_bindings_scope_state_idx")
  @@map("result_usage_settlement_bindings")
  @@schema("bua")
}

/// BUA-001..BUA-006: durable provider-backed subscription payment order. Amount and scope are
/// server-owned; the browser submits only the immutable catalog plan id and idempotency key.
model PaymentOrderRecord {
  id                String    @id @db.Uuid
  provider          String    @db.VarChar(32)
  providerOrderCode BigInt    @map("provider_order_code")
  scopeKey          String    @map("scope_key") @db.VarChar(200)
  scopeType         String    @map("scope_type") @db.VarChar(24)
  organizationId    String    @map("organization_id") @db.Uuid
  workspaceId       String?   @map("workspace_id") @db.Uuid
  actorId           String    @map("actor_id") @db.Uuid
  securityEpoch     Int       @map("security_epoch")
  planId            String    @map("plan_id") @db.VarChar(64)
  amountVnd         Int       @map("amount_vnd")
  currency          String    @default("VND") @db.VarChar(3)
  status            String    @db.VarChar(24)
  checkoutUrl       String?   @map("checkout_url") @db.Text
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(200)
  failureCode       String?   @map("failure_code") @db.VarChar(80)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision          Int       @default(1)

  @@unique([provider, providerOrderCode], map: "payment_orders_provider_order_key")
  @@unique([scopeKey, idempotencyKey], map: "payment_orders_scope_idempotency_key")
  @@index([organizationId, workspaceId, status, createdAt], map: "payment_orders_scope_status_idx")
  @@index([scopeKey, providerOrderCode], map: "payment_orders_scope_order_idx")
  @@map("payment_orders")
  @@schema("bua")
}

/// BUA-007: provider webhook inbox is append-only/idempotent and stores the verified payload.
model PaymentWebhookInboxRecord {
  id                 String    @id @db.Uuid
  provider           String    @db.VarChar(32)
  providerEventId    String    @map("provider_event_id") @db.VarChar(256)
  providerOrderCode  BigInt?   @map("provider_order_code")
  amountVnd          Int?      @map("amount_vnd")
  statusFromProvider String?   @map("status_from_provider") @db.VarChar(32)
  signature          String    @db.VarChar(512)
  payload            Json
  state              String    @db.VarChar(24)
  attemptCount       Int       @default(0) @map("attempt_count")
  lastError          String?   @map("last_error") @db.VarChar(160)
  receivedAt         DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt        DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId], map: "payment_webhook_inbox_provider_event_key")
  @@index([provider, providerOrderCode, state], map: "payment_webhook_inbox_order_state_idx")
  @@index([state, receivedAt], map: "payment_webhook_inbox_state_idx")
  @@map("payment_webhook_inbox")
  @@schema("bua")
}

/// BUA-008: one current subscription projection per scope, rebuilt from durable orders.
model SubscriptionRecord {
  id             String    @id @db.Uuid
  scopeKey       String    @unique(map: "subscriptions_scope_key") @map("scope_key") @db.VarChar(200)
  scopeType      String    @map("scope_type") @db.VarChar(24)
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  planId         String    @map("plan_id") @db.VarChar(64)
  source         String    @db.VarChar(32)
  status         String    @db.VarChar(24)
  currentOrderId String?   @map("current_order_id") @db.Uuid
  startsAt       DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime? @map("ends_at") @db.Timestamptz(6)
  revision       Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, workspaceId, status], map: "subscriptions_scope_status_idx")
  @@map("subscriptions")
  @@schema("bua")
}

/// BUA-009: immutable invoice projection for each settled payment order.
model InvoiceRecord {
  id             String    @id @db.Uuid
  paymentOrderId String    @unique(map: "invoices_payment_order_key") @map("payment_order_id") @db.Uuid
  scopeKey       String    @map("scope_key") @db.VarChar(200)
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  planId         String    @map("plan_id") @db.VarChar(64)
  amountVnd      Int       @map("amount_vnd")
  currency       String    @default("VND") @db.VarChar(3)
  status         String    @db.VarChar(24)
  issuedAt       DateTime  @map("issued_at") @db.Timestamptz(6)
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, workspaceId, issuedAt], map: "invoices_scope_issued_idx")
  @@map("invoices")
  @@schema("bua")
}

/// BUA-010: payment audit records are append-only and written in the settlement transaction.
model PaymentAuditEventRecord {
  id             String   @id @db.Uuid
  paymentOrderId String   @map("payment_order_id") @db.Uuid
  scopeKey       String   @map("scope_key") @db.VarChar(200)
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String?  @map("workspace_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  action         String   @db.VarChar(80)
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([paymentOrderId, action], map: "payment_audit_order_action_key")
  @@index([organizationId, workspaceId, createdAt], map: "payment_audit_scope_created_idx")
  @@map("payment_audit_events")
  @@schema("bua")
}
