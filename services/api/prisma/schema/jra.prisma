/// JRA-002/JRA-004/JRA-005/JRA-023: immutable, value-bounded execution request metadata.
/// Object references are opaque; this record never stores source bytes, credentials, URLs,
/// filesystem paths, database connection data, or executable commands.
model ExecutionRequestDescriptorRecord {
  id                             String   @id @db.Uuid
  resultUsageSettlementBindingId String   @unique(map: "execution_request_descriptors_settlement_binding_key") @map("result_usage_settlement_binding_id") @db.Uuid
  jobId                          String   @unique(map: "execution_request_descriptors_job_key") @map("job_id") @db.Uuid
  stepId                         String   @map("step_id") @db.Uuid
  scopeType                      String   @map("scope_type") @db.VarChar(24)
  organizationId                 String   @map("organization_id") @db.Uuid
  workspaceId                    String?  @map("workspace_id") @db.Uuid
  projectId                      String?  @map("project_id") @db.Uuid
  actionType                     String   @map("action_type") @db.VarChar(128)
  actionVersion                  Int      @map("action_version")
  inputSchemaId                  String   @map("input_schema_id") @db.VarChar(128)
  outputSchemaId                 String   @map("output_schema_id") @db.VarChar(128)
  handlerDigest                  String   @map("handler_digest") @db.Char(64)
  requiredCapabilities           Json     @map("required_capabilities")
  sideEffectClass                String   @map("side_effect_class") @db.VarChar(32)
  riskClass                      String   @map("risk_class") @db.VarChar(24)
  inputObjectIds                 Json     @map("input_object_ids")
  inputManifestHash              String   @map("input_manifest_hash") @db.Char(64)
  parameters                     Json
  outputObjectId                 String   @map("output_object_id") @db.VarChar(512)
  outputMaxBytes                 Int      @map("output_max_bytes")
  outputMediaType                String   @map("output_media_type") @db.VarChar(128)
  deadline                       DateTime @db.Timestamptz(6)
  locale                         String   @db.VarChar(16)
  canonicalHash                  String   @unique(map: "execution_request_descriptors_hash_key") @map("canonical_hash") @db.Char(64)
  createdAt                      DateTime @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, workspaceId, projectId, jobId], map: "execution_request_descriptors_scope_job_idx")
  @@map("execution_request_descriptors")
  @@schema("jra")
}

/// JRA-033/DDA-061: immutable, attempt-bound server workload envelope. The JSON payload is
/// validated by the application domain before it is persisted; this row stores no bytes,
/// credentials, URLs, paths, or worker-authored authority.
model ExecutionWorkloadEnvelopeRecord {
  workloadId         String   @id @map("workload_id") @db.Uuid
  descriptorId       String   @map("descriptor_id") @db.Uuid
  attemptId          String   @unique(map: "execution_workload_envelopes_attempt_key") @map("attempt_id") @db.Uuid
  jobId              String   @map("job_id") @db.Uuid
  scopeType          String   @map("scope_type") @db.VarChar(24)
  organizationId     String   @map("organization_id") @db.Uuid
  workspaceId        String?  @map("workspace_id") @db.Uuid
  projectId          String?  @map("project_id") @db.Uuid
  descriptorHash     String   @map("descriptor_hash") @db.Char(64)
  attemptBindingHash String   @map("attempt_binding_hash") @db.Char(64)
  envelope           Json
  canonicalHash      String   @unique(map: "execution_workload_envelopes_hash_key") @map("canonical_hash") @db.Char(64)
  createdAt          DateTime @map("created_at") @db.Timestamptz(6)

  @@unique([descriptorId, attemptId], map: "execution_workload_envelopes_descriptor_attempt_key")
  @@index([organizationId, workspaceId, projectId, jobId], map: "execution_workload_envelopes_scope_job_idx")
  @@map("execution_workload_envelopes")
  @@schema("jra")
}

/// JRA-007/JRA-008/JRA-023: one durable, attempt-bound completion receipt. Result references
/// remain opaque and are accepted only inside the same transaction as the attempt CAS/outbox.
model WorkerCompletionRecord {
  id                 String   @id @db.Uuid
  jobId              String   @map("job_id") @db.Uuid
  attemptId          String   @map("attempt_id") @db.Uuid
  scopeType          String   @map("scope_type") @db.VarChar(24)
  organizationId     String   @map("organization_id") @db.Uuid
  workspaceId        String?  @map("workspace_id") @db.Uuid
  projectId          String?  @map("project_id") @db.Uuid
  workerId           String   @map("worker_id") @db.Uuid
  securityEpoch      Int      @map("security_epoch")
  leaseTokenHash     String   @map("lease_token_hash") @db.Char(64)
  expectedRevision   Int      @map("expected_revision")
  completionRevision Int      @map("completion_revision")
  outcome            String   @db.VarChar(16)
  resultManifestHash String?  @map("result_manifest_hash") @db.Char(64)
  resultReferences   Json     @map("result_references")
  fingerprint        String   @unique(map: "worker_completions_fingerprint_key") @db.Char(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([attemptId], map: "worker_completions_attempt_key")
  @@index([organizationId, workspaceId, projectId, createdAt], map: "worker_completions_scope_time_idx")
  @@map("worker_completions")
  @@schema("jra")
}

/// JRA-007/JRA-023/JRA-031: stable non-terminal result preparation derived only from the
/// latest leased attempt and immutable execution request descriptor.
model WorkerResultPreparationRecord {
  submissionId                   String   @id @map("submission_id") @db.Uuid
  jobId                          String   @map("job_id") @db.Uuid
  attemptId                      String   @map("attempt_id") @db.Uuid
  scopeType                      String   @map("scope_type") @db.VarChar(24)
  organizationId                 String   @map("organization_id") @db.Uuid
  workspaceId                    String?  @map("workspace_id") @db.Uuid
  projectId                      String?  @map("project_id") @db.Uuid
  workerId                       String   @map("worker_id") @db.Uuid
  securityEpoch                  Int      @map("security_epoch")
  leaseTokenHash                 String   @map("lease_token_hash") @db.Char(64)
  expectedRevision               Int      @map("expected_revision")
  descriptorId                   String   @map("descriptor_id") @db.Uuid
  descriptorHash                 String   @map("descriptor_hash") @db.Char(64)
  attemptBindingHash             String   @map("attempt_binding_hash") @db.Char(64)
  resultUsageSettlementBindingId String   @map("result_usage_settlement_binding_id") @db.Uuid
  outputSchemaId                 String   @map("output_schema_id") @db.VarChar(128)
  outputPolicy                   Json     @map("output_policy")
  outputPolicyHash               String   @map("output_policy_hash") @db.Char(64)
  subjectBindings                Json     @map("subject_bindings")
  idempotencyKey                 String   @map("idempotency_key") @db.VarChar(200)
  fingerprint                    String   @unique(map: "worker_result_preparations_fingerprint_key") @db.Char(64)
  createdAt                      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([attemptId], map: "worker_result_preparations_attempt_key")
  @@unique([scopeType, organizationId, workspaceId, projectId, idempotencyKey], map: "worker_result_preparations_scope_idempotency_key")
  @@index([organizationId, workspaceId, projectId, createdAt], map: "worker_result_preparations_scope_time_idx")
  @@map("worker_result_preparations")
  @@schema("jra")
}

/// JRA-012/JRA-023/JRA-031: exact replay and public content-free verification binding for one
/// atomic canonical result-manifest commit.
model WorkerResultFinalizationRecord {
  submissionId             String   @id @map("submission_id") @db.Uuid
  jobId                    String   @map("job_id") @db.Uuid
  attemptId                String   @map("attempt_id") @db.Uuid
  resultManifestId         String   @map("result_manifest_id") @db.Uuid
  scopeType                String   @map("scope_type") @db.VarChar(24)
  organizationId           String   @map("organization_id") @db.Uuid
  workspaceId              String?  @map("workspace_id") @db.Uuid
  projectId                String?  @map("project_id") @db.Uuid
  workerId                 String   @map("worker_id") @db.Uuid
  securityEpoch            Int      @map("security_epoch")
  descriptorId             String   @map("descriptor_id") @db.Uuid
  descriptorHash           String   @map("descriptor_hash") @db.Char(64)
  outputSchemaId           String   @map("output_schema_id") @db.VarChar(128)
  engineVersion            String   @map("engine_version") @db.VarChar(128)
  sourceArtifactVersionIds Json     @map("source_artifact_version_ids")
  sourceLineageHash        String   @map("source_lineage_hash") @db.Char(64)
  subjectBindings          Json     @map("subject_bindings")
  attestationReferences    Json     @map("attestation_references")
  fingerprint              String   @unique(map: "worker_result_finalizations_fingerprint_key") @db.Char(64)
  resultManifestHash       String   @map("result_manifest_hash") @db.Char(64)
  attemptRevision          Int      @map("attempt_revision")
  jobRevision              Int      @map("job_revision")
  finalizedAt              DateTime @map("finalized_at") @db.Timestamptz(6)

  @@unique([attemptId], map: "worker_result_finalizations_attempt_key")
  @@unique([resultManifestId], map: "worker_result_finalizations_manifest_key")
  @@index([organizationId, workspaceId, projectId, finalizedAt], map: "worker_result_finalizations_scope_time_idx")
  @@map("worker_result_finalizations")
  @@schema("jra")
}

