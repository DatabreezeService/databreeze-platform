/// JRA-owned durable typed work, transitions, dispatch outbox, and approvals.
/// Cross-module artifact, dataset, identity, and entitlement references remain opaque.
model TypedActionDefinitionRecord {
  id                    String   @id @db.Uuid
  actionType            String   @map("action_type") @db.VarChar(128)
  version               Int
  inputSchemaId         String   @map("input_schema_id") @db.VarChar(128)
  outputSchemaId        String   @map("output_schema_id") @db.VarChar(128)
  handlerDigest         String   @map("handler_digest") @db.Char(64)
  requiredCapabilities  Json     @map("required_capabilities")
  sideEffectClass       String   @map("side_effect_class") @db.VarChar(32)
  riskClass             String   @map("risk_class") @db.VarChar(24)
  defaultTimeoutSeconds Int      @map("default_timeout_seconds")
  maxAttempts           Int      @map("max_attempts")
  approvalClass         String   @map("approval_class") @db.VarChar(16)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([actionType, version], map: "typed_actions_type_version_key")
  @@map("typed_action_definitions")
  @@schema("jra")
}

model JobRecord {
  id                String    @id @db.Uuid
  scopeType         String    @map("scope_type") @db.VarChar(24)
  organizationId    String    @map("organization_id") @db.Uuid
  workspaceId       String?   @map("workspace_id") @db.Uuid
  projectId         String?   @map("project_id") @db.Uuid
  requestedBy       String    @map("requested_by") @db.Uuid
  actionType        String    @map("action_type") @db.VarChar(128)
  actionVersion     Int       @map("action_version")
  inputManifestHash String    @map("input_manifest_hash") @db.Char(64)
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(200)
  state             String    @db.VarChar(32)
  revision          Int       @default(1)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)

  @@unique([scopeType, organizationId, workspaceId, projectId, idempotencyKey], map: "jobs_scope_idempotency_key")
  @@index([organizationId, workspaceId, projectId, state, revision], map: "jobs_scope_state_idx")
  @@index([organizationId, workspaceId, projectId, state, createdAt], map: "jobs_worker_ready_scan_idx")
  @@index([actionType, actionVersion], map: "jobs_action_idx")
  @@map("jobs")
  @@schema("jra")
}

model JobTransitionRecord {
  id         String   @id @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  fromState  String?  @map("from_state") @db.VarChar(32)
  toState    String   @map("to_state") @db.VarChar(32)
  actorId    String   @map("actor_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  revision   Int

  @@unique([jobId, revision], map: "job_transitions_job_revision_key")
  @@index([jobId, occurredAt], map: "job_transitions_job_time_idx")
  @@map("job_transitions")
  @@schema("jra")
}

model JobOutboxRecord {
  id          String    @id @db.Uuid
  jobId       String    @map("job_id") @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(80)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  @@unique([jobId, eventType], map: "job_outbox_job_event_key")
  @@index([deliveredAt, createdAt], map: "job_outbox_delivery_idx")
  @@map("job_outbox")
  @@schema("jra")
}

model ExecutionAttemptRecord {
  id                 String    @id @db.Uuid
  jobId              String    @map("job_id") @db.Uuid
  scopeType          String    @map("scope_type") @db.VarChar(24)
  organizationId     String    @map("organization_id") @db.Uuid
  workspaceId        String?   @map("workspace_id") @db.Uuid
  projectId          String?   @map("project_id") @db.Uuid
  attemptNumber      Int       @map("attempt_number")
  executorType       String    @map("executor_type") @db.VarChar(24)
  executorId         String    @map("executor_id") @db.Uuid
  leaseTokenHash     String    @map("lease_token_hash") @db.Char(64)
  leaseExpiresAt     DateTime  @map("lease_expires_at") @db.Timestamptz(6)
  state              String    @db.VarChar(16)
  createdAt          DateTime  @map("created_at") @db.Timestamptz(6)
  heartbeatAt        DateTime  @map("heartbeat_at") @db.Timestamptz(6)
  startedAt          DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(6)
  resultManifestHash String?   @map("result_manifest_hash") @db.Char(64)
  revision           Int       @default(1)

  @@unique([jobId, attemptNumber], map: "execution_attempts_job_number_key")
  @@index([organizationId, workspaceId, projectId, state, leaseExpiresAt], map: "execution_attempts_scope_state_lease_idx")
  @@index([jobId, revision], map: "execution_attempts_job_revision_idx")
  @@map("execution_attempts")
  @@schema("jra")
}

model ResultManifestRecord {
  id                       String   @id @db.Uuid
  jobId                    String   @map("job_id") @db.Uuid
  attemptId                String   @map("attempt_id") @db.Uuid
  scopeType                String   @map("scope_type") @db.VarChar(24)
  organizationId           String   @map("organization_id") @db.Uuid
  workspaceId              String?  @map("workspace_id") @db.Uuid
  projectId                String?  @map("project_id") @db.Uuid
  sourceArtifactVersionIds Json     @map("source_artifact_version_ids")
  outputIds                Json     @map("output_ids")
  outputHashes             Json     @map("output_hashes")
  evidenceCoverage         String   @map("evidence_coverage") @db.VarChar(16)
  handlerDigest            String   @map("handler_digest") @db.Char(64)
  engineVersion            String   @map("engine_version") @db.VarChar(128)
  attemptNumber            Int      @map("attempt_number")
