/// DSO-owned immutable synchronization operations. Payloads are limited to
/// approved metadata or derived classes; original content is never stored here.
model DeviceSyncOperationRecord {
  id                String    @id @db.Uuid
  scopeType         String    @map("scope_type") @db.VarChar(24)
  organizationId    String    @map("organization_id") @db.Uuid
  workspaceId       String?   @map("workspace_id") @db.Uuid
  projectId         String?   @map("project_id") @db.Uuid
  deviceId          String    @map("device_id") @db.Uuid
  entityType        String    @map("entity_type") @db.VarChar(64)
  entityId          String    @map("entity_id") @db.Uuid
  kind              String    @db.VarChar(16)
  payloadClass      String    @map("payload_class") @db.VarChar(40)
  payloadDigest     String    @map("payload_digest") @db.VarChar(128)
  encryptedPayload  String?   @map("encrypted_payload") @db.VarChar(16384)
  dependencyIds     Json      @map("dependency_ids")
  baseRevision      Int?      @map("base_revision")
  status            String    @db.VarChar(16)
  revision          Int       @default(1)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  acknowledgedAt    DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(200)
  syncSequence      Int       @default(autoincrement()) @unique(map: "device_sync_operations_sync_sequence_key") @map("sync_sequence")

  @@index([organizationId, workspaceId, projectId, status], map: "device_sync_operations_scope_status_idx")
  @@index([deviceId, createdAt], map: "device_sync_operations_device_created_idx")
  @@index([organizationId, syncSequence], map: "device_sync_operations_org_sequence_idx")
  @@index([entityType, entityId], map: "device_sync_operations_entity_idx")
  @@map("device_sync_operations")
  @@schema("dso")
}

/// DSO-018: conflicts are explicit records; no last-write-wins resolution is implicit.
model DeviceSyncConflictRecord {
  id                String    @id @db.Uuid
  operationId       String    @map("operation_id") @db.Uuid
  scopeType         String    @map("scope_type") @db.VarChar(24)
  organizationId    String    @map("organization_id") @db.Uuid
  workspaceId       String?   @map("workspace_id") @db.Uuid
  projectId         String?   @map("project_id") @db.Uuid
  deviceId          String    @map("device_id") @db.Uuid
  entityType        String    @map("entity_type") @db.VarChar(64)
  entityId          String    @map("entity_id") @db.Uuid
  reason            String    @db.VarChar(32)
  status            String    @db.VarChar(16)
  expectedRevision  Int?      @map("expected_revision")
  actualRevision    Int?      @map("actual_revision")
  detectedAt        DateTime  @map("detected_at") @db.Timestamptz(6)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@unique([operationId, reason], map: "device_sync_conflicts_operation_reason_key")
  @@index([organizationId, workspaceId, projectId, status], map: "device_sync_conflicts_scope_status_idx")
  @@index([deviceId, detectedAt], map: "device_sync_conflicts_device_detected_idx")
  @@map("device_sync_conflicts")
  @@schema("dso")
}

/// DSO-019, DSO-020: strict-Local packages carry only signed metadata and digests.
model StrictLocalPackageManifestRecord {
  id               String    @id @db.Uuid
  scopeType        String    @map("scope_type") @db.VarChar(24)
  organizationId   String    @map("organization_id") @db.Uuid
  workspaceId      String?   @map("workspace_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  deviceId         String    @map("device_id") @db.Uuid
  purpose          String    @db.VarChar(200)
  destinationClass String    @map("destination_class") @db.VarChar(64)
  itemDigests      Json      @map("item_digests")
  packageDigest    String    @map("package_digest") @db.VarChar(128)
  issuedAt         DateTime  @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  status           String    @db.VarChar(16)
  revision         Int       @default(1)

  @@index([organizationId, workspaceId, projectId, status], map: "strict_local_packages_scope_status_idx")
  @@index([deviceId, expiresAt], map: "strict_local_packages_device_expiry_idx")
  @@map("strict_local_package_manifests")
  @@schema("dso")
}

/// DSO-021: receipts prove manifest/digest verification without copying source content.
model DeviceTransferReceiptRecord {
  id               String   @id @db.Uuid
  packageId        String   @map("package_id") @db.Uuid
  deviceId         String   @map("device_id") @db.Uuid
  destinationClass String   @map("destination_class") @db.VarChar(64)
  packageDigest    String   @map("package_digest") @db.VarChar(128)
  receivedAt       DateTime @map("received_at") @db.Timestamptz(6)
  manifestVerified Boolean  @map("manifest_verified")
  status           String   @db.VarChar(16)

  @@unique([packageId, deviceId], map: "device_transfer_receipts_package_device_key")
  @@index([deviceId, receivedAt], map: "device_transfer_receipts_device_received_idx")
  @@map("device_transfer_receipts")
  @@schema("dso")
}

/// DSO-023: malformed or offline audit fragments remain quarantined until reconciliation.
model LocalAuditFragmentRecord {
  id                     String   @id @db.Uuid
  scopeType              String   @map("scope_type") @db.VarChar(24)
  organizationId         String   @map("organization_id") @db.Uuid
  workspaceId            String?  @map("workspace_id") @db.Uuid
  projectId              String?  @map("project_id") @db.Uuid
  deviceId               String   @map("device_id") @db.Uuid
  fragmentDigest         String   @map("fragment_digest") @db.VarChar(128)
  encryptedFragmentRef   String   @map("encrypted_fragment_ref") @db.VarChar(512)
  status                 String   @db.VarChar(16)
  receivedAt             DateTime @map("received_at") @db.Timestamptz(6)

  @@unique([deviceId, fragmentDigest], map: "local_audit_fragments_device_digest_key")
  @@index([organizationId, workspaceId, projectId, status], map: "local_audit_fragments_scope_status_idx")
  @@map("local_audit_fragments")
  @@schema("dso")
}

/// IAM-020, DSO-005: opaque grants are revocable, scoped, and never contain local paths.
model DeviceGrantRecord {
  id                  String   @id @db.Uuid
  deviceId            String   @map("device_id") @db.Uuid
  scopeType           String   @map("scope_type") @db.VarChar(24)
  organizationId      String   @map("organization_id") @db.Uuid
  workspaceId         String?  @map("workspace_id") @db.Uuid
  projectId           String?  @map("project_id") @db.Uuid
  bindingId           String   @map("binding_id") @db.Uuid
  capabilityDigest    String   @map("capability_digest") @db.VarChar(128)
  authorizationEpoch  Int      @map("authorization_epoch")
  effects             Json
  issuedAt            DateTime @map("issued_at") @db.Timestamptz(6)
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)
  status              String   @db.VarChar(16)
  revision            Int      @default(1)

  @@index([organizationId, workspaceId, projectId, deviceId, status], map: "device_grants_scope_device_status_idx")
  @@index([deviceId, expiresAt], map: "device_grants_device_expiry_idx")
  @@map("device_grants")
  @@schema("dso")
}

/// DSO-003/004: device-reported capabilities are content-free, opaque, and revisioned.
model DeviceCapabilityRecord {
  id                String   @id @db.Uuid
  deviceId          String   @map("device_id") @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  capabilityType    String   @map("capability_type") @db.VarChar(32)
  opaqueLocalHandle String?  @map("opaque_local_handle") @db.VarChar(512)
  constraintDigest  String   @map("constraint_digest") @db.VarChar(128)
  status            String   @db.VarChar(16)
  reportedAt        DateTime @map("reported_at") @db.Timestamptz(6)
  revision          Int      @default(1)

  @@index([organizationId, deviceId, status], map: "device_capabilities_org_device_status_idx")
  @@index([deviceId, reportedAt], map: "device_capabilities_device_reported_idx")
  @@map("device_capabilities")
  @@schema("dso")
}

/// DSO-005: operational grants carry only typed actions, classifications, and payload classes.
model DeviceOperationalGrantRecord {
  id                              String   @id @db.Uuid
  deviceId                        String   @map("device_id") @db.Uuid
  organizationId                  String   @map("organization_id") @db.Uuid
  workspaceId                     String   @map("workspace_id") @db.Uuid
  capabilityId                    String   @map("capability_id") @db.Uuid
  authorizationEpoch              Int      @map("authorization_epoch")
  allowedActionTypes              Json     @map("allowed_action_types")
  allowedDataClassifications     Json     @map("allowed_data_classifications")
  synchronizationPayloadClasses   Json     @map("synchronization_payload_classes")
  issuedAt                        DateTime @map("issued_at") @db.Timestamptz(6)
  expiresAt                       DateTime? @map("expires_at") @db.Timestamptz(6)
  status                          String   @db.VarChar(16)
  revision                        Int      @default(1)

  @@index([organizationId, workspaceId, deviceId, status], map: "device_operational_grants_scope_status_idx")
  @@index([deviceId, expiresAt], map: "device_operational_grants_device_expiry_idx")
  @@index([capabilityId], map: "device_operational_grants_capability_idx")
  @@map("device_operational_grants")
  @@schema("dso")
}

/// DSO-008/026: immutable workspace data-mode policy versions.
model DeviceDataModePolicyRecord {
  id                       String   @id @db.Uuid
  policyId                 String   @map("policy_id") @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  workspaceId              String   @map("workspace_id") @db.Uuid
  revision                 Int
  mode                     String   @db.VarChar(16)
  allowedPayloadClasses   Json     @map("allowed_payload_classes")
  allowedPlacementKinds   Json     @map("allowed_placement_kinds")
  allowedExecutorClasses  Json     @map("allowed_executor_classes")
  allowedDestinationClasses Json   @map("allowed_destination_classes")
  canonicalHash            String   @map("canonical_hash") @db.VarChar(64)
  publishedAt              DateTime @map("published_at") @db.Timestamptz(6)

  @@unique([policyId, revision], map: "device_data_mode_policies_policy_revision_key")
  @@index([organizationId, workspaceId, policyId, revision], map: "device_data_mode_policies_scope_idx")
  @@map("device_data_mode_policies")
  @@schema("dso")
}
