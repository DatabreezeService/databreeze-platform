{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "e2e/**/*.ts",
    "e2e-dev/**/*.ts",
    "playwright.config.ts",
    "playwright.dev.config.ts",
    "security-headers.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
